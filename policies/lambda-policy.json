{
    "Version": "2012-10-17",
    "Statement": 
    [
        {
            "Sid": "ReadUploadedObjects",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::$BUCKET/raw/*"
        },
        {
            "Sid": "WriteProcessedObjects",
            "Effect": "Allow",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::$BUCKET/processed/*"
        },
        {
            "Sid": "WriteLogs",
            "Effect": "Allow",
            "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
            "Resource": "arn:aws:logs:$AWS_REGION:$ACCOUNT:log-group:/aws/lambda/$FN:*"
        }
    ]
}